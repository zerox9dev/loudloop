# --- core ---
APP_URL=http://localhost:3000
# --- Свой S3 (контейнер s3, SeaweedFS) — хранилище медиа постов ---
# в docker compose S3_ENDPOINT подставляется сам (http://s3:8333); значение ниже — для pnpm dev
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=loudloop
# ключи придумываете сами: openssl rand -hex 16 / openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Адрес бакета, по которому Instagram/Threads скачивают медиа. Наружу нужен только порт 8333
# (Tailscale Funnel / cloudflared), панель остаётся закрытой. Пример: https://media.example.com/loudloop
S3_PUBLIC_URL=http://localhost:8333/loudloop
# запасной вариант без S3: публичный адрес самой панели, отдающей /media/*
PUBLIC_MEDIA_URL=
# обязательно: openssl rand -base64 32 (приложение не стартует с пустым)
AUTH_SECRET=
# 32 байта base64: openssl rand -base64 32 — шифрует токены площадок в БД
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@loudloop.local
# пусто = сгенерируется при первом запуске и выведется в логи web (docker compose logs web)
ADMIN_PASSWORD=
ADMIN_NAME=Мой профиль
# 1 = создать демо-площадки с синтетическими данными (mock-провайдер)
DEMO_MODE=1
# язык демо-данных и интерфейса по умолчанию: en | uk | ru
DEMO_LOCALE=en
ADMIN_LOCALE=en
TZ=Europe/Warsaw
COOKIE_SECURE=false

# --- dev (pnpm dev вне докера) ---
DATABASE_URL=postgres://socialboard:socialboard@localhost:5433/socialboard
REDIS_URL=redis://localhost:6380
MEDIA_DIR=./data/media

# --- Короткие ссылки со счётчиком кликов: публичный адрес, где доступен /l/* (пусто = только UTM-метки) ---
LINKS_BASE_URL=

# --- Claude: генерация постов и подсказки под целями (без ключа — шаблоны) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram: статистика через MTProto (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Meta: Instagram API with Instagram Login ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Meta: Threads API ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- LinkedIn (developer.linkedin.com → app с продуктами Sign In with LinkedIn + Share on LinkedIn) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# версия Posts API (YYYYMM); LinkedIn поддерживает версии ~12 месяцев
LINKEDIN_API_VERSION=202608

# --- X (developer.x.com): OAuth 2.0 «Connect with X» ---
X_CLIENT_ID=
X_CLIENT_SECRET=
# устаревший путь: OAuth 1.0a ключи приложения для ручной вставки токенов пользователя
X_API_KEY=
X_API_SECRET=
