{
  "name": "loudloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file=.env worker/index.ts",
    "build:node": "esbuild worker=worker/index.ts migrate=lib/db/migrate.ts seed=lib/db/seed.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env lib/db/migrate.ts",
    "db:seed": "tsx --env-file=.env lib/db/seed.ts",
    "tg:login": "tsx --env-file=.env scripts/tg-login.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "twitter-api-v2": "^1.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "msw": "^3.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.16.0",
  "license": "AGPL-3.0-only"
}
